{
  "version": "2.17",
  "variables": {
    "primary": { "type": "color", "value": "#3B82F6" },
    "primary-hover": { "type": "color", "value": "#3575DD" },
    "secondary": { "type": "color", "value": "#6B7280" },
    "secondary-hover": { "type": "color", "value": "#606773" },
    "ghost-hover": { "type": "color", "value": "#3B82F61A" },
    "foreground": { "type": "color", "value": "#FFFFFF" },
    "canvas": { "type": "color", "value": "#FAFAFA" },
    "muted": { "type": "color", "value": "#6B7280" },
    "font": { "type": "string", "value": "Inter" },
    "radius": { "type": "number", "value": 6 }
  },
  "children": [
    {
      "type": "frame",
      "id": "btn-primary",
      "name": "Button/Primary",
      "reusable": true,
      "x": 0,
      "y": 0,
      "layout": "horizontal",
      "height": 40,
      "gap": 8,
      "padding": [16, 24],
      "alignItems": "center",
      "justifyContent": "center",
      "cornerRadius": "$radius",
      "fill": "$primary",
      "clip": true,
      "children": [
        {
          "type": "icon",
          "id": "btn-primary-spinner",
          "name": "Spinner",
          "library": "lucide",
          "icon": "loader-circle",
          "width": 16,
          "height": 16,
          "fill": "$foreground",
          "enabled": false
        },
        {
          "type": "text",
          "id": "btn-primary-label",
          "name": "Label",
          "content": "Button",
          "fontFamily": "$font",
          "fontSize": 16,
          "fontWeight": "500",
          "fill": "$foreground"
        }
      ]
    },
    {
      "type": "frame",
      "id": "btn-secondary",
      "name": "Button/Secondary",
      "reusable": true,
      "x": 200,
      "y": 0,
      "layout": "horizontal",
      "height": 40,
      "gap": 8,
      "padding": [16, 24],
      "alignItems": "center",
      "justifyContent": "center",
      "cornerRadius": "$radius",
      "fill": "$secondary",
      "clip": true,
      "children": [
        {
          "type": "icon",
          "id": "btn-secondary-spinner",
          "name": "Spinner",
          "library": "lucide",
          "icon": "loader-circle",
          "width": 16,
          "height": 16,
          "fill": "$foreground",
          "enabled": false
        },
        {
          "type": "text",
          "id": "btn-secondary-label",
          "name": "Label",
          "content": "Button",
          "fontFamily": "$font",
          "fontSize": 16,
          "fontWeight": "500",
          "fill": "$foreground"
        }
      ]
    },
    {
      "type": "frame",
      "id": "btn-outline",
      "name": "Button/Outline",
      "reusable": true,
      "x": 400,
      "y": 0,
