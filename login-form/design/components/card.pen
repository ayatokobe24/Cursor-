      "width": 360,
      "gap": 6,
      "padding": [16, 20],
      "stroke": "$card-border",
      "strokeWidth": { "bottom": 1 },
      "strokeAlignment": "inner",
      "children": [
        {
          "type": "text",
          "id": "card-header-title",
          "name": "CardTitle",
          "content": "Card title",
          "fontFamily": "$font",
          "fontSize": 18,
          "fontWeight": "600",
          "fill": "$card-foreground",
