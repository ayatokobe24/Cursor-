{
  "version": "2.17",
  "variables": {
    "card-bg": { "type": "color", "value": "#FFFFFF" },
    "card-border": { "type": "color", "value": "#E5E7EB" },
    "card-foreground": { "type": "color", "value": "#111827" },
    "card-muted": { "type": "color", "value": "#6B7280" },
    "card-image": { "type": "color", "value": "#F3F4F6" },
    "canvas": { "type": "color", "value": "#FAFAFA" },
    "primary": { "type": "color", "value": "#3B82F6" },
    "font": { "type": "string", "value": "Inter" },
    "card-radius": { "type": "number", "value": 8 }
  },
  "children": [
    {
      "type": "frame",
      "id": "card-title",
      "name": "Card/Title",
      "reusable": true,
      "x": 0,
      "y": 0,
      "layout": "vertical",
      "width": 320,
      "children": [
        {
          "type": "text",
          "id": "card-title-text",
          "name": "Title",
          "content": "Card title",
          "fontFamily": "$font",
          "fontSize": 18,
          "fontWeight": "600",
          "fill": "$card-foreground",
          "textGrowth": "fixed-width",
          "width": "fill_container"
        }
      ]
    },
    {
      "type": "frame",
      "id": "card-description",
      "name": "Card/Description",
      "reusable": true,
      "x": 360,
      "y": 0,
      "layout": "vertical",
      "width": 320,
      "children": [
        {
          "type": "text",
          "id": "card-description-text",
          "name": "Description",
          "content": "Card description",
          "fontFamily": "$font",
          "fontSize": 14,
          "fontWeight": "normal",
          "fill": "$card-muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "lineHeight": 1.4
        }
      ]
    },
    {
