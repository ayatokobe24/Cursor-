      "name": "Card/Content",
      "reusable": true,
      "x": 400,
      "y": 80,
      "layout": "vertical",
      "width": 360,
      "padding": 20,
      "gap": 8,
      "slot": [],
      "children": [
        {
          "type": "text",
          "id": "card-content-body",
